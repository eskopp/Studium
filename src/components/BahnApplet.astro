<div class="applet" data-bahn>
  <div class="applet-controls">
    <label><span>Exzentrizität ε: <output data-o-e></output></span><input type="range" data-e min="0" max="2" step="0.01" value="0.6" /></label>
  </div>
  <canvas data-c height="320" role="img" aria-label="Bahn eines Körpers im Gravitationsfeld als Kegelschnitt"></canvas>
  <div class="applet-results" aria-live="polite">
    <p>Bahnform: <strong data-r-typ></strong></p>
    <p>Gesamtenergie W: <strong data-r-w></strong></p>
    <p>Perihel r<sub>min</sub>: <strong data-r-pe></strong></p>
    <p>Aphel r<sub>max</sub>: <strong data-r-ap></strong></p>
  </div>
  <p class="applet-note">Bahn r(φ) = p / (1 + ε cos φ) mit dem Halbparameter p = L²/(γ m² M). Alle Bahnen haben denselben Drehimpuls L. Die Energie ist W = (ε² − 1) · γmM/(2p), also negativ für ε &lt; 1, null für ε = 1 und positiv für ε &gt; 1. Längen sind in Einheiten von p angegeben.</p>
</div>

<script>
  (function () {
    document.querySelectorAll('[data-bahn]').forEach(function (root) {
      if (root.dataset.ready) return; root.dataset.ready = '1';
      var q = function (s) { return root.querySelector(s); };
      var fmt = function (x, d) { return x.toLocaleString('de-DE', { minimumFractionDigits: d, maximumFractionDigits: d }); };
      var cv = q('[data-c]'), ctx = cv.getContext('2d'), ie = q('[data-e]');
      function draw() {
        var e = +ie.value; q('[data-o-e]').textContent = fmt(e, 2);
        var typ = e < 0.005 ? 'Kreis' : (e < 0.995 ? 'Ellipse' : (e < 1.005 ? 'Parabel' : 'Hyperbel'));
        var W = e * e - 1; if (typ === 'Parabel') W = 0;
        q('[data-r-typ]').textContent = typ;
        q('[data-r-w]').textContent = (typ === 'Parabel' ? '0' : fmt(W, 2)) + ' · γmM/(2p)' + (W < 0 ? ' (gebunden)' : ' (nicht gebunden)');
        q('[data-r-pe]').textContent = fmt(1 / (1 + e), 3) + ' p';
        q('[data-r-ap]').textContent = e < 0.995 ? fmt(1 / (1 - e), 3) + ' p' : 'unendlich';
        var dpr = window.devicePixelRatio || 1, Wd = cv.clientWidth, Ht = 320;
        cv.width = Wd * dpr; cv.height = Ht * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        var col = getComputedStyle(root).color;
        var rmax = e < 0.8 ? 1 / (1 - e) : 5; var view = Math.min(rmax, 4.2);
        var s = Math.min((Wd / 2 - 16), (Ht / 2 - 16)) / Math.min(view, 2.2) * (e < 0.8 ? 1 : 0.9);
        if (e < 0.995) s = Math.min((Wd - 40) / (1 / (1 - e) + 1 / (1 + e)), (Ht - 40) / (2 * Math.sqrt(1 / (1 - e * e)) * 1.0 + 0.01));
        var fx = e < 0.995 ? 20 + (1 / (1 - e)) * s : Wd * 0.62, fy = Ht / 2;
        ctx.strokeStyle = 'rgba(128,128,128,.35)'; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(10, fy); ctx.lineTo(Wd - 10, fy); ctx.stroke();
        ctx.strokeStyle = '#2563eb'; ctx.lineWidth = 3; ctx.beginPath(); var first = true;
        for (var i = -1800; i <= 1800; i++) {
          var ph = i / 1800 * Math.PI, d = 1 + e * Math.cos(ph); if (d <= 0.05) { first = true; continue; }
          var r = 1 / d; if (r > 6) { first = true; continue; }
          var x = fx + r * s * Math.cos(ph), y = fy - r * s * Math.sin(ph);
          if (x < -50 || x > Wd + 50 || y < -50 || y > Ht + 50) { first = true; continue; }
          if (first) { ctx.moveTo(x, y); first = false; } else ctx.lineTo(x, y);
        }
        ctx.stroke();
        ctx.fillStyle = '#d97706'; ctx.beginPath(); ctx.arc(fx, fy, 8, 0, 7); ctx.fill();
        ctx.fillStyle = col; ctx.font = '12px sans-serif'; ctx.fillText('Sonne', fx - 16, fy + 24);
        var rp = 1 / (1 + e); ctx.fillStyle = '#ea580c'; ctx.beginPath(); ctx.arc(fx + rp * s, fy, 5, 0, 7); ctx.fill(); ctx.fillText('Perihel', fx + rp * s - 14, fy - 12);
        if (e < 0.995) { ctx.beginPath(); ctx.arc(fx - s / (1 - e), fy, 5, 0, 7); ctx.fill(); ctx.fillText('Aphel', fx - s / (1 - e) + 4, fy - 12); }
      }
      ie.addEventListener('input', draw); window.addEventListener('resize', draw); draw();
    });
  })();
</script>

<style is:global>
  .applet { border: 1px solid rgba(128,128,128,.4); border-radius: .9rem; padding: 1.1rem; margin: 1.5rem 0; display: grid; gap: 1rem; }
  .applet-controls { display: grid; gap: .8rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .applet label { display: grid; gap: .25rem; font-size: .9rem; }
  .applet input[type='range'], .applet select { width: 100%; }
  .applet select { padding: .3rem; border: 1px solid rgba(128,128,128,.5); border-radius: .4rem; background: transparent; color: inherit; }
  .applet select option { background: #fff; color: #111; }
  .applet canvas { width: 100%; height: 320px; border-radius: .5rem; background: rgba(128,128,128,.06); display: block; }
  .applet-results { display: grid; gap: .2rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .applet-results p, .applet-note { margin: 0; }
  .applet-note { font-size: .85rem; opacity: .8; }
</style>
